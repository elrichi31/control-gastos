# Copiar a .env.local y completar. Sin valores reales en este archivo.

# --- Supabase ---
# Obligatoria. Cliente del navegador (URL del proyecto).
NEXT_PUBLIC_SUPABASE_URL=
# Obligatoria. Clave anon, llega al navegador (auth de Supabase).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Obligatoria. Clave service_role, solo servidor: toda la API de datos, cron y MCP la usan.
SUPABASE_SERVICE_ROLE_KEY=

# --- NextAuth ---
# Obligatoria en producción. Origen canónico de la app (registro, sesiones, callbacks).
NEXTAUTH_URL=
# Obligatoria. Firma las sesiones de NextAuth y las móviles.
NEXTAUTH_SECRET=

# --- Google (opcional: sin ellas no se ofrece login con Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON {"correo@dominio.com":"<uuid del usuario en Supabase>"}. Solo entran las cuentas listadas.
AUTH_GOOGLE_ACCOUNTS=

# --- Sesiones (opcionales) ---
# Fecha ISO: invalida las sesiones iniciadas antes de ella.
AUTH_SESSION_NOT_BEFORE=
# "true" activa el registro de sesiones (requiere su migración en Supabase).
AUTH_SESSION_REGISTRY_ENABLED=

# --- Cron ---
# Obligatoria para los cron (process-recurring-expenses y sync-email). Sin ella responden 503.
CRON_SECRET=

# --- MCP / ChatGPT (opcionales; ver docs/MCP.md) ---
# Obligatoria para activar MCP. Origen HTTPS canónico, sin barra final.
MCP_PUBLIC_ORIGIN=
# Modo legacy con client secret: se usan las tres juntas (el secreto, de 32+ caracteres) o ninguna.
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
# Callbacks HTTPS separados por coma.
MCP_REDIRECT_URIS=

# --- Importación de correo Yahoo (opcional: sin las tres, sync-email no importa) ---
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=
# UUID del usuario de Supabase que recibe los movimientos importados.
YAHOO_IMPORT_USER_ID=

# --- Jev / Typesafe (opcional: sin la clave se omite la mejora) ---
TYPESAFE_API_KEY=
